---
/**
 * Photos page — Photo gallery with filters and pagination.
 * Shows editorial empty state when no photos are published.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import EmptyState from "@components/EmptyState.astro";
import Pagination from "@components/Pagination.astro";
import type { Locale } from "@i18n/translations";

export function getStaticPaths() {
  const paths: any[] = [];
  // Spanish
  paths.push({ params: { locale: "es" } });
  for (let i = 2; i <= 3; i++) {
    paths.push({ params: { locale: "es", page: String(i) } });
  }
  // English
  paths.push({ params: { locale: "en" } });
  for (let i = 2; i <= 3; i++) {
    paths.push({ params: { locale: "en", page: String(i) } });
  }
  return paths;
}

const { locale, page = "1" } = Astro.params;
const pageNum = parseInt(page as string, 10) || 1;
const basePath = locale === "en" ? "/en/photos" : "/fotos";
const isHome = pageNum === 1;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: locale === "es" ? "Fotos" : "Photos",
  url: `https://photo.patriciobet.dev${isHome ? basePath : `${basePath}/pagina/${pageNum}/`}`,
  description: locale === "es"
    ? "Selección de fotografías de Patricio Betancourt."
    : "Photograph selection by Patricio Betancourt.",
  isPartOf: {
    "@type": "WebSite",
    name: "Patricio Betancourt",
  },
};
---

<BaseLayout
  title={locale === "es" ? "Fotos — Patricio Betancourt" : "Photos — Patricio Betancourt"}
  description={locale === "es"
    ? "Selección de fotografías de Patricio Betancourt."
    : "Photograph selection by Patricio Betancourt."}
  locale={locale}
  path={isHome ? basePath : `${basePath}/pagina/${pageNum}/`}
  jsonLd={jsonLd}
>
  <div class="container section">
    <!-- Breadcrumbs -->
    <nav aria-label="Migas de pan" style={{ marginBottom: "1.5rem" }}>
      <ol style={{ display: "flex", flexWrap: "wrap", listStyle: "none", gap: "0.5rem", fontSize: "0.875rem", color: "var(--text-muted)", padding: 0, margin: 0 }}>
        <li>
          <a href={locale === "en" ? "/en/" : "/"} style={{ color: "var(--text-muted)", textDecoration: "none" }}>
            {locale === "es" ? "Inicio" : "Home"}
          </a>
        </li>
        <li aria-current="page" style={{ color: "var(--text)", fontWeight: 500 }}>
          {locale === "es" ? "Fotos" : "Photos"}
        </li>
        {!isHome && (
          <li style={{ color: "var(--text)", fontWeight: 500 }}>
            {locale === "es" ? "Página" : "Page"} {pageNum}
          </li>
        )}
      </ol>
    </nav>

    <!-- Title -->
    <h1 style={{ marginBottom: "0.5rem" }}>{locale === "es" ? "Fotos" : "Photos"}</h1>
    <p style={{ fontSize: "var(--text-lg)", color: "var(--text-muted)", marginBottom: "2rem", maxWidth: "48ch" }}>
      {locale === "es"
        ? "Una selección de imágenes, sin recortes ni ruido."
        : "A selection of images, without crops or noise."}
    </p>

    <!-- Filters -->
    <div style={{ display: "flex", flexWrap: "wrap", gap: "0.5rem", marginBottom: "2rem" }}>
      <button class="chip" aria-pressed="true" style={{ cursor: "default" }}>
        {locale === "es" ? "Todas" : "All"}
      </button>
      <button class="chip" aria-pressed="false">{locale === "es" ? "Colección" : "Collection"}</button>
      <button class="chip" aria-pressed="false">{locale === "es" ? "Etiqueta" : "Tag"}</button>
      <button class="chip" aria-pressed="false">{locale === "es" ? "Año" : "Year"}</button>
    </div>

    <!-- Empty state -->
    <EmptyState
      locale={locale}
      title={locale === "es" ? "AÚN NO HAY FOTOGRAFÍAS PUBLICADAS" : "NO PHOTOGRAPHS PUBLISHED YET"}
      text={locale === "es"
        ? "Estoy preparando la primera selección. Vuelve pronto o explora los videos."
        : "I'm preparing the first selection. Come back soon or explore the videos."}
      actions={[
        { label: locale === "es" ? "Ver videos" : "View videos", href: locale === "en" ? "/en/videos" : "/videos" },
        { label: locale === "es" ? "Sobre mí" : "About", href: locale === "en" ? "/en/about" : "/sobre-mi" },
      ]}
    />

    <!-- Pagination (hidden when empty — only show if there were photos) -->
    {pageNum > 1 && (
      <Pagination
        locale={locale}
        currentPage={pageNum}
        totalPages={3}
        baseUrl={basePath}
      />
    )}
  </div>
</BaseLayout>
