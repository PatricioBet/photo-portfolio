---
/**
 * Tags page — Lists all tags.
 * Tag detail pages with < 8 items get noindex,follow.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Locale } from "@i18n/translations";

export function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "en" } },
  ];
}

const { locale } = Astro.props;
const basePath = locale === "en" ? "/en/tags" : "/etiquetas";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: locale === "es" ? "Etiquetas" : "Tags",
  url: `https://photo.patriciobet.dev${basePath}`,
  description: locale === "es"
    ? "Todas las etiquetas del archivo."
    : "All tags in the archive.",
  isPartOf: { "@type": "WebSite", name: "Patricio Betancourt" },
};
---

<BaseLayout
  title={locale === "es" ? "Etiquetas — Patricio Betancourt" : "Tags — Patricio Betancourt"}
  description={locale === "es"
    ? "Todas las etiquetas del archivo."
    : "All tags in the archive."}
  locale={locale}
  path={basePath}
  jsonLd={jsonLd}
>
  <div class="container section">
    <nav aria-label="Migas de pan" style={{ marginBottom: "1.5rem" }}>
      <ol style={{ display: "flex", flexWrap: "wrap", listStyle: "none", gap: "0.5rem", fontSize: "0.875rem", color: "var(--text-muted)", padding: 0, margin: 0 }}>
        <li>
          <a href={locale === "en" ? "/en/" : "/"} style={{ color: "var(--text-muted)", textDecoration: "none" }}>
            {locale === "es" ? "Inicio" : "Home"}
          </a>
        </li>
        <li aria-current="page" style={{ color: "var(--text)", fontWeight: 500 }}>
          {locale === "es" ? "Etiquetas" : "Tags"}
        </li>
      </ol>
    </nav>

    <h1 style={{ marginBottom: "0.5rem" }}>{locale === "es" ? "Etiquetas" : "Tags"}</h1>
    <p style={{ fontSize: "var(--text-lg)", color: "var(--text-muted)", marginBottom: "2rem" }}>
      {locale === "es"
        ? "Explora el archivo por etiquetas."
        : "Explore the archive by tags."}
    </p>

    <!-- Tags grid (empty until media is published) -->
    <div style={{ textAlign: "center", padding: "4rem 0", color: "var(--text-muted)" }}>
      <p style={{ fontSize: "var(--text-lg)" }}>
        {locale === "es"
          ? "Las etiquetas aparecerán cuando se publiquen las primeras piezas."
          : "Tags will appear when the first pieces are published."}
      </p>
    </div>
  </div>
</BaseLayout>
