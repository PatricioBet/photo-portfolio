---
/**
 * Search page — Client-side search with Pagefind. noindex.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Search from "@components/Search.astro";
import type { Locale } from "@i18n/translations";

export function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "en" } },
  ];
}

const { locale } = Astro.props;
const basePath = locale === "en" ? "/en/search" : "/buscar";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: locale === "es" ? "Buscar" : "Search",
  url: `https://photo.patriciobet.dev${basePath}`,
  description: locale === "es"
    ? "Busca en el archivo de fotografía y video."
    : "Search the photography and video archive.",
  potentialAction: {
    "@type": "SearchAction",
    target: `${basePath}?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  title={locale === "es" ? "Buscar — Patricio Betancourt" : "Search — Patricio Betancourt"}
  description={locale === "es"
    ? "Busca en el archivo de fotografía y video."
    : "Search the photography and video archive."}
  locale={locale}
  path={basePath}
  noindex={true}
  jsonLd={jsonLd}
>
  <div class="container section">
    <nav aria-label="Migas de pan" style={{ marginBottom: "1.5rem" }}>
      <ol style={{ display: "flex", flexWrap: "wrap", listStyle: "none", gap: "0.5rem", fontSize: "0.875rem", color: "var(--text-muted)", padding: 0, margin: 0 }}>
        <li>
          <a href={locale === "en" ? "/en/" : "/"} style={{ color: "var(--text-muted)", textDecoration: "none" }}>
            {locale === "es" ? "Inicio" : "Home"}
          </a>
        </li>
        <li aria-current="page" style={{ color: "var(--text)", fontWeight: 500 }}>
          {locale === "es" ? "Buscar" : "Search"}
        </li>
      </ol>
    </nav>

    <h1 style={{ marginBottom: "0.5rem" }}>{locale === "es" ? "Buscar" : "Search"}</h1>
    <p style={{ fontSize: "var(--text-lg)", color: "var(--text-muted)", marginBottom: "2rem" }}>
      {locale === "es"
        ? "Busca por título, descripción, colección o etiqueta."
        : "Search by title, description, collection or tag."}
    </p>

    <Search locale={locale} />
  </div>

  <!-- Pagefind script (loaded for client-side search) -->
  <script
    src="/pagefind/pagefind-ui.js"
    defer
    onload="console.log('Pagefind loaded')"
  />
</BaseLayout>
