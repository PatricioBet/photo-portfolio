---
/**
 * 503 page — Maintenance.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import type { Locale } from "@i18n/translations";

export function getStaticPaths() {
  return [
    { params: { locale: "es" } },
    { params: { locale: "en" } },
  ];
}

const { locale } = Astro.props;

Astro.response.setStatusAndMessage(503, "Service Unavailable");
Astro.response.headers.set("Retry-After", "3600");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: locale === "es" ? "Mantenimiento" : "Maintenance",
  url: Astro.url.href,
  httpStatus: 503,
};
---

<BaseLayout
  title={locale === "es" ? "Mantenimiento — Patricio Betancourt" : "Maintenance — Patricio Betancourt"}
  description={locale === "es"
    ? "El sitio está en mantenimiento."
    : "The site is under maintenance."}
  locale={locale}
  path={Astro.url.pathname}
  noindex={true}
  jsonLd={jsonLd}
>
  <div class="container section" style={{ textAlign: "center", maxWidth: "48ch", marginInline: "auto" }}>
    <h1 style={{ marginBottom: "1rem" }}>503</h1>
    <p style={{ fontSize: "var(--text-xl)", color: "var(--text-muted)", marginBottom: "1.5rem" }}>
      {locale === "es" ? "SITIO EN MANTENIMIENTO" : "SITE UNDER MAINTENANCE"}
    </p>
    <p style={{ color: "var(--text-muted)", marginBottom: "2rem" }}>
      {locale === "es"
        ? "Estamos actualizando el sitio. Vuelve en unos minutos."
        : "We're updating the site. Come back in a few minutes."}
    </p>
    <a href={Astro.url.href} class="btn btn-primary">
      {locale === "es" ? "Reintentar" : "Retry"}
    </a>
  </div>
</BaseLayout>
