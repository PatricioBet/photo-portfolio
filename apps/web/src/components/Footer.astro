---
/**
 * Footer — secondary navigation, legal links, RSS, language switcher, and copyright.
 */
import type { Locale } from "@i18n/translations";

export interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

const mainLinks = [
  { key: "nav.photos", href: locale === "en" ? "/en/photos" : "/fotos" },
  { key: "nav.videos", href: locale === "en" ? "/en/videos" : "/videos" },
  { key: "nav.collections", href: locale === "en" ? "/en/collections" : "/colecciones" },
  { key: "nav.about", href: locale === "en" ? "/en/about" : "/sobre-mi" },
  { key: "nav.contact", href: locale === "en" ? "/en/contact" : "/contacto" },
];

const legalLinks = [
  { key: "footer.privacy", href: locale === "en" ? "/en/privacy" : "/privacidad" },
  { key: "footer.terms", href: locale === "en" ? "/en/terms" : "/terminos" },
  { key: "footer.accessibility", href: locale === "en" ? "/en/accessibility" : "/accesibilidad" },
  { key: "footer.credits", href: locale === "en" ? "/en/credits" : "/creditos" },
];

function getLabel(key: string): string {
  const map: Record<string, Record<string, string>> = {
    "nav.photos": { es: "Fotos", en: "Photos" },
    "nav.videos": { es: "Videos", en: "Videos" },
    "nav.collections": { es: "Colecciones", en: "Collections" },
    "nav.about": { es: "Sobre mí", en: "About" },
    "nav.contact": { es: "Contacto", en: "Contact" },
    "footer.privacy": { es: "Privacidad", en: "Privacy" },
    "footer.terms": { es: "Términos", en: "Terms" },
    "footer.accessibility": { es: "Accesibilidad", en: "Accessibility" },
    "footer.credits": { es: "Créditos", en: "Credits" },
    "footer.rss": { es: "RSS", en: "RSS" },
    "footer.development": { es: "Desarrollo", en: "Development" },
    "footer.copyright": {
      es: "© Patricio Betancourt. Todos los derechos reservados.",
      en: "© Patricio Betancourt. All rights reserved.",
    },
    "footer.selfhosted": { es: "Sitio autoalojado", en: "Self-hosted site" },
  };
  return map[key]?.[locale] || key;
}

function getLanguageHref(): string {
  const stripLocale = currentPath.replace(/^\/en(\/|$)/, "/");
  return locale === "en" ? `/${stripLocale}` : `/en${stripLocale}`;
}

function getLanguageLabel(): string {
  return locale === "en" ? "Español" : "English";
}
---

<footer class="footer no-print">
  <div class="container">
    <div class="footer__grid">
      <!-- Main navigation -->
      <div>
        <nav aria-label="Navegación principal">
          <ul class="footer__links">
            {mainLinks.map((link) => (
              <li>
                <a href={link.href}>{getLabel(link.key)}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Legal -->
      <div>
        <nav aria-label="Enlaces legales">
          <ul class="footer__links">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href}>{getLabel(link.key)}</a>
              </li>
            ))}
            <li>
              <a href={locale === "en" ? "/en/rss.xml" : "/rss.xml"}>{getLabel("footer.rss")}</a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- External + Language -->
      <div>
        <nav aria-label="Enlaces externos">
          <ul class="footer__links">
            <li>
              <a href="https://patriciobet.dev" target="_blank" rel="noopener noreferrer">
                patriciobet.dev
              </a>
            </li>
            <li>
              <a href="https://github.com/patob" target="_blank" rel="noopener noreferrer">
                GitHub
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/patricio-betancourt" target="_blank" rel="noopener noreferrer">
                LinkedIn
              </a>
            </li>
          </ul>
        </nav>
        <div style={{ marginTop: "1rem" }}>
          <a
            href={getLanguageHref()}
            class="btn btn-ghost"
            style={{ fontSize: "var(--text-sm)", padding: "0.4rem 0.75rem" }}
            aria-label={getLanguageLabel()}
          >
            {locale === "en" ? "ES" : "EN"}
          </a>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>{getLabel("footer.copyright")}</p>
    </div>
  </div>
</footer>
