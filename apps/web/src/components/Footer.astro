---
/**
 * Footer — secondary navigation, legal links, RSS, language switcher, and copyright.
 */
import type { Locale } from "@i18n/translations";

export interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

const isEn = locale === "en";

const mainLinks = [
  { label: isEn ? "Photos" : "Fotos", href: isEn ? "/en/photos" : "/fotos" },
  { label: isEn ? "Videos" : "Videos", href: isEn ? "/en/videos" : "/videos" },
  { label: isEn ? "Collections" : "Colecciones", href: isEn ? "/en/collections" : "/colecciones" },
  { label: isEn ? "About" : "Sobre mí", href: isEn ? "/en/about" : "/sobre-mi" },
  { label: isEn ? "Contact" : "Contacto", href: isEn ? "/en/contact" : "/contacto" },
];

const legalLinks = [
  { label: isEn ? "Privacy" : "Privacidad", href: isEn ? "/en/privacy" : "/privacidad" },
  { label: isEn ? "Terms" : "Términos", href: isEn ? "/en/terms" : "/terminos" },
  { label: isEn ? "Accessibility" : "Accesibilidad", href: isEn ? "/en/accessibility" : "/accesibilidad" },
  { label: isEn ? "Credits" : "Créditos", href: isEn ? "/en/credits" : "/creditos" },
];

const rssHref = isEn ? "/en/rss.xml" : "/rss.xml";
const copyright = isEn
  ? "© Patricio Betancourt. All rights reserved."
  : "© Patricio Betancourt. Todos los derechos reservados.";

function getLanguageHref(): string {
  const stripLocale = currentPath.replace(/^\/en(\/|$)/, "/");
  return isEn ? `/${stripLocale}` : `/en${stripLocale}`;
}

function getLanguageLabel(): string {
  return isEn ? "Español" : "English";
}
---

<footer class="footer no-print">
  <div class="container">
    <div class="footer__grid">
      <!-- Main navigation -->
      <div>
        <nav aria-label="Navegación principal">
          <ul class="footer__links">
            {mainLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Legal -->
      <div>
        <nav aria-label="Enlaces legales">
          <ul class="footer__links">
            {legalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
            <li>
              <a href={rssHref}>RSS</a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- External + Language -->
      <div>
        <nav aria-label="Enlaces externos">
          <ul class="footer__links">
            <li>
              <a href="https://patriciobet.dev" target="_blank" rel="noopener noreferrer">
                patriciobet.dev
              </a>
            </li>
            <li>
              <a href="https://github.com/patob" target="_blank" rel="noopener noreferrer">
                GitHub
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/patricio-betancourt" target="_blank" rel="noopener noreferrer">
                LinkedIn
              </a>
            </li>
          </ul>
        </nav>
        <div style={{ marginTop: "1rem" }}>
          <a
            href={getLanguageHref()}
            class="btn btn-ghost"
            style={{ fontSize: "var(--text-sm)", padding: "0.4rem 0.75rem" }}
            aria-label={getLanguageLabel()}
          >
            {isEn ? "ES" : "EN"}
          </a>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>{copyright}</p>
    </div>
  </div>
</footer>
