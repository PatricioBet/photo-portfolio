---
/**
 * Pagination — accessible pagination component.
 */
import type { Locale } from "@i18n/translations";

export interface Props {
  locale: Locale;
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { locale, currentPage, totalPages, baseUrl } = Astro.props;

if (totalPages <= 1) {
  return null;
}

function pageUrl(page: number): string {
  if (page === 1) return baseUrl;
  return `${baseUrl}/pagina/${page}/`;
}

function enPageUrl(page: number): string {
  if (page === 1) return baseUrl;
  return `${baseUrl}/page/${page}/`;
}
---

<nav class="pagination" aria-label="Paginación">
  {currentPage > 1 && (
    <a
      href={locale === "en" ? enPageUrl(currentPage - 1) : pageUrl(currentPage - 1)}
      class="btn btn-secondary"
      aria-label="Página anterior"
    >
      ← Anterior
    </a>
  )}

  <ol style={{ display: "flex", listStyle: "none", gap: "var(--space-2)", padding: 0, margin: 0 }}>
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
      <li>
        {page === currentPage ? (
          <span aria-current="page" class="btn btn-ghost" style={{ cursor: "default" }}>
            {page}
          </span>
        ) : (
          <a
            href={locale === "en" ? enPageUrl(page) : pageUrl(page)}
            class="btn btn-ghost"
            aria-label={`Página ${page}`}
          >
            {page}
          </a>
        )}
      </li>
    ))}
  </ol>

  {currentPage < totalPages && (
    <a
      href={locale === "en" ? enPageUrl(currentPage + 1) : pageUrl(currentPage + 1)}
      class="btn btn-secondary"
      aria-label="Página siguiente"
    >
      Siguiente →
    </a>
  )}
</nav>
