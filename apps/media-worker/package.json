{
  "name": "media-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Media processing worker for photo portfolio",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bull-board/api": "^5.20.0",
    "@bull-board/express": "^5.20.0",
    "bullmq": "^5.8.0",
    "sharp": "^0.33.4",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
