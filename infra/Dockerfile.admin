# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/admin/package.json ./apps/admin/
COPY packages/ui/package.json ./packages/ui/
COPY packages/contracts/package.json ./packages/contracts/
RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts

# ── Build ─────────────────────────────────────────────────────
FROM deps AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=deps /app/packages/ui/node_modules ./packages/ui/node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY apps/admin/ ./apps/admin/
COPY packages/ui/ ./packages/ui/
COPY packages/contracts/ ./packages/contracts/
COPY tsconfig.base.json ./
RUN corepack enable && pnpm --filter admin build

# ── Production (static files via serve) ───────────────────────
FROM node:22-alpine AS production
WORKDIR /app

COPY --from=build /app/apps/admin/dist ./dist
COPY --from=build /app/apps/admin/package.json ./
COPY --from=build /app/packages/ui/package.json ./packages/ui/
COPY --from=build /app/packages/contracts/package.json ./packages/contracts/

RUN corepack enable && \
    pnpm install --prod --ignore-scripts && \
    npm install -g serve && \
    rm -rf /root/.npm /root/.node-gyp /tmp/*

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["serve", "-s", "dist", "-l", "3000"]
