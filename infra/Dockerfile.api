# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

# Install sharp/build dependencies and ffmpeg-static deps
RUN apk add --no-cache \
    build-base \
    g++ \
    make \
    jpeg-dev \
    libpng-dev \
    vips-dev \
    ffmpeg \
    ffmpeg-dev \
    tiff-dev \
    libwebp-dev \
    libheif-dev \
    zlib-dev

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/db/package.json ./packages/db/
COPY packages/contracts/package.json ./packages/contracts/
RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts

# ── Build ─────────────────────────────────────────────────────
FROM deps AS build
COPY --from=deps /app/node_modules ./node_modules
COPY apps/api/ ./apps/api/
COPY packages/db/ ./packages/db/
COPY packages/contracts/ ./packages/contracts/
COPY tsconfig.base.json ./
RUN corepack enable && pnpm --filter @photo-portfolio/db build && pnpm --filter @photo-portfolio/contracts build && pnpm --filter api build

# ── Production ────────────────────────────────────────────────
FROM node:22-alpine AS production
RUN apk add --no-cache ffmpeg

WORKDIR /app

# Copy workspace structure
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/db/package.json ./packages/db/
COPY packages/contracts/package.json ./packages/contracts/

# Copy built outputs
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/db/dist ./packages/db/dist
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist

# Copy node_modules from deps stage (all npm dependencies)
COPY --from=deps /app/node_modules ./node_modules

# Create workspace packages in node_modules (pnpm v10 doesn't create symlinks)
RUN mkdir -p node_modules/@photo-portfolio/db/dist node_modules/@photo-portfolio/contracts/dist && \
    cp packages/db/package.json node_modules/@photo-portfolio/db/package.json && \
    cp -r packages/db/dist/* node_modules/@photo-portfolio/db/dist/ && \
    cp packages/contracts/package.json node_modules/@photo-portfolio/contracts/package.json && \
    cp -r packages/contracts/dist/* node_modules/@photo-portfolio/contracts/dist/

# Non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

CMD ["node", "apps/api/dist/main.js"]
