# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

# Install sharp/build dependencies and ffmpeg-static deps
RUN apk add --no-cache \
    build-base \
    g++ \
    make \
    jpeg-dev \
    libpng-dev \
    vips-dev \
    ffmpeg \
    ffmpeg-dev \
    tiff-dev \
    libwebp-dev \
    libheif-dev \
    zlib-dev

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/db/package.json ./packages/db/
COPY packages/contracts/package.json ./packages/contracts/
RUN corepack enable && pnpm fetch --ignore-scripts

# ── Build ─────────────────────────────────────────────────────
FROM deps AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY apps/api/ ./apps/api/
COPY packages/db/ ./packages/db/
COPY packages/contracts/ ./packages/contracts/
COPY tsconfig.base.json ./
RUN corepack enable && pnpm --filter api build

# ── Production ────────────────────────────────────────────────
FROM node:22-alpine AS production
RUN apk add --no-cache ffmpeg

# sharp prebuilds for alpine
RUN apk add --no-cache build-base g++ make jpeg-dev libpng-dev vips-dev tiff-dev libwebp-dev zlib-dev

WORKDIR /app

COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/package.json ./
COPY --from=build /app/packages/db/package.json ./packages/db/
COPY --from=build /app/packages/contracts/package.json ./packages/contracts/

# Install production deps only
RUN corepack enable && \
    pnpm install --prod --ignore-scripts && \
    rm -rf /root/.npm /root/.node-gyp /tmp/*

# Non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

CMD ["node", "dist/main"]
