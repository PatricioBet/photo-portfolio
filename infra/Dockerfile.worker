# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS base

# Install sharp/build dependencies and ffmpeg
RUN apk add --no-cache \
    build-base \
    g++ \
    make \
    jpeg-dev \
    libpng-dev \
    vips-dev \
    ffmpeg \
    ffmpeg-dev \
    tiff-dev \
    libwebp-dev \
    libheif-dev \
    zlib-dev

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/media-worker/package.json ./apps/media-worker/
COPY packages/db/package.json ./packages/db/
RUN corepack enable && pnpm install --frozen-lockfile --ignore-scripts

# ── Build ─────────────────────────────────────────────────────
FROM deps AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/media-worker/node_modules ./apps/media-worker/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY apps/media-worker/ ./apps/media-worker/
COPY packages/db/ ./packages/db/
COPY tsconfig.base.json ./
RUN corepack enable && pnpm --filter @photo-portfolio/db build && pnpm --filter media-worker build

# ── Production ────────────────────────────────────────────────
FROM node:22-alpine AS production
RUN apk add --no-cache ffmpeg

# sharp prebuilds for alpine
RUN apk add --no-cache build-base g++ make jpeg-dev libpng-dev vips-dev tiff-dev libwebp-dev zlib-dev

WORKDIR /app

# Copy workspace root for pnpm to resolve workspace:* deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/media-worker/package.json ./apps/media-worker/
COPY packages/db/package.json ./packages/db/

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/media-worker/node_modules ./apps/media-worker/node_modules
COPY --from=build /app/packages/db/node_modules ./packages/db/node_modules

COPY --from=build /app/apps/media-worker/dist ./dist
COPY --from=build /app/packages/db/dist ./packages/db/dist

# Non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

# Memory limit enforced at compose level (2GB)
# Node max-old-space-size set at runtime via env var
ENV NODE_OPTIONS="--max-old-space-size=1900"

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9000/health || exit 1

EXPOSE 9000

CMD ["node", "dist/main.js"]
