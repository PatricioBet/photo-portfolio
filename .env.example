# Database
POSTGRES_USER=patriciobet
POSTGRES_PASSWORD=
POSTGRES_DB=photo
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://localhost:6379

# API
API_URL=http://localhost:3000
API_PORT=3000

# Public site
WEB_URL=https://photo.patriciobet.dev

# Admin
ADMIN_URL=https://admin-photo.patriciobet.dev

# Cloudflare Tunnel (only when configured)
CLOUDFLARE_TUNNEL_TOKEN=

# Local storage
LOCAL_STORAGE_PATH=/data/media

# Node
NODE_ENV=development

# Media Worker
WORKER_CONCURRENCY_PHOTO=4
WORKER_CONCURRENCY_VIDEO=1
WORKER_MEMORY_LIMIT=2147483648

# Contact
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Patricio Betancourt

# Turnstile (optional, remove if not used)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WebAuthn RP ID
RP_ID=photo.patriciobet.dev
