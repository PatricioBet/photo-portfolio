# ============================================================
# photo.patriciobet.dev — environment template
# Copy to .env.local (ignored) or inject through Docker secrets.
# NEVER put real values in this file or in git.
# ============================================================

# --- Runtime -------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=America/Guayaquil

# --- Public origins ------------------------------------------
PUBLIC_SITE_URL=https://photo.patriciobet.dev
ADMIN_SITE_URL=https://admin-photo.patriciobet.dev
CDN_BASE_URL=https://cdn-photo.patriciobet.dev

# --- Database ------------------------------------------------
POSTGRES_DB=photo_portfolio
POSTGRES_USER=photo_app
POSTGRES_PASSWORD=
DATABASE_URL=postgres://photo_app:CHANGE_ME@postgres:5432/photo_portfolio

# --- Redis / queue -------------------------------------------
REDIS_URL=redis://redis:6379

# --- Session / auth ------------------------------------------
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
REAUTH_WINDOW_MINUTES=5
WEBAUTHN_RP_NAME=Patricio Betancourt Photography
WEBAUTHN_RP_ID=admin-photo.patriciobet.dev
WEBAUTHN_ORIGIN=https://admin-photo.patriciobet.dev
RECOVERY_CODE_COUNT=10
PASSKEY_MINIMUM=2

# --- Cloudflare Access ---------------------------------------
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_JWKS_URL=

# --- Cloudflare Tunnel ---------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare R2 (separate least-privilege tokens) ---------
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_PRIVATE=photo-private
R2_BUCKET_PUBLIC=photo-public
R2_PUBLIC_BASE_URL=https://cdn-photo.patriciobet.dev
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
R2_WORKER_ACCESS_KEY_ID=
R2_WORKER_SECRET_ACCESS_KEY=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=photo-backups

# --- Media pipeline ------------------------------------------
MEDIA_TMP_DIR=/tmp/photo-media
MEDIA_MAX_IMAGE_MB=50
MEDIA_MAX_IMAGE_MP=200
MEDIA_MAX_VIDEO_MB=2048
MEDIA_MAX_VIDEO_MINUTES=10
MEDIA_IMAGE_CONCURRENCY=2
MEDIA_VIDEO_CONCURRENCY=1
MEDIA_JOB_TIMEOUT_SECONDS=1800
MEDIA_FFMPEG_THREADS=2

# --- Builder / releases --------------------------------------
BUILD_DEBOUNCE_SECONDS=60
BUILD_KEEP_RELEASES=3
BUILD_WORKSPACE=/srv/photo/releases
BUILD_CURRENT_LINK=/srv/photo/current
BUILD_INTERNAL_API_URL=http://api:3000
BUILD_TRIGGER_TOKEN=
CLOUDFLARE_CACHE_PURGE_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Contact form --------------------------------------------
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=no-reply@patriciobet.dev
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_RATE_LIMIT_PER_IP_HOUR=3
CONTACT_MAX_CHARS=5000

# --- Observability -------------------------------------------
SENTRY_DSN=
UPTIME_HEARTBEAT_URL=
ALERT_EMAIL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Backups -------------------------------------------------
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=03:30

# --- Admin bootstrap (CLI only, never in web) ----------------
ADMIN_BOOTSTRAP_TOKEN_TTL_MINUTES=15
